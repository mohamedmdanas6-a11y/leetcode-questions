    // ---------- Button controller ----------
    public void actionPerformed(ActionEvent e) {
        if (e.getSource() == findButton) {
            findScholarships();
        } else if (e.getSource() == clearButton) {
            clearForm();
        }
    }

    void findScholarships() {
        String name = nameField.getText().trim();
        String ageText = ageField.getText().trim();

        if (name.isEmpty() || ageText.isEmpty()) {
            resultArea.setText("Please enter Name and Age before searching.");
            return;
        }

        int age;
        try {
            age = Integer.parseInt(ageText);
        } catch (NumberFormatException ex) {
            resultArea.setText("Age must be a number.");
            return;
        }

        String gender = genderChoice.getSelectedItem();
        String community = communityChoice.getSelectedItem();
        String education = educationChoice.getSelectedItem();
        boolean wantsLoan = loanChoice.getSelectedItem().equalsIgnoreCase("Yes");

        List<Scholarship> eligibleScholarships = new ArrayList<>();
        List<Scholarship> eligibleLoans = new ArrayList<>();
        for (Scholarship s : buildSchemeList()) {
            if (s.matches(age, gender, community, education)) {
                if (s.type.equalsIgnoreCase("Loan")) {
                    eligibleLoans.add(s);
                } else {
                    eligibleScholarships.add(s);
                }
            }
        }

        StringBuilder sb = new StringBuilder();
        sb.append("Name        : ").append(name).append("\n");
        sb.append("Age         : ").append(age).append("\n");
        sb.append("Gender      : ").append(gender).append("\n");
        sb.append("Community   : ").append(community).append("\n");
        sb.append("Education   : ").append(education).append("\n");
        sb.append("Bank Loan   : ").append(loanChoice.getSelectedItem()).append("\n");
        sb.append("---------------------------------------------\n\n");

        // ---------- Scholarship section ----------
        sb.append("SCHOLARSHIP DETAILS\n");
        sb.append("---------------------------------------------\n");
        if (eligibleScholarships.isEmpty()) {
            sb.append("No matching scholarships found in this list.\n\n");
        } else {
            sb.append("Eligible for ").append(eligibleScholarships.size()).append(" scholarship(s):\n\n");
            int i = 1;
            for (Scholarship s : eligibleScholarships) {
                sb.append(i++).append(". ").append(s.name)
                        .append("  -  ").append(s.amount).append("\n");
            }
            sb.append("\n");
        }

        // ---------- Education Loan section (only if requested) ----------
        if (wantsLoan) {
            sb.append("BANK LOAN DETAILS\n");
            sb.append("---------------------------------------------\n");
            if (eligibleLoans.isEmpty()) {
                sb.append("No matching bank loan schemes found in this list.\n\n");
            } else {
                sb.append("Eligible for ").append(eligibleLoans.size()).append(" loan scheme(s):\n\n");
                int i = 1;
                for (Scholarship s : eligibleLoans) {
                    sb.append(i++).append(". ").append(s.name)
                            .append("  -  ").append(s.amount).append("\n");
                }
                sb.append("\n");
            }
        }

        sb.append("Note: Verify final eligibility and deadlines on the official\n");
        sb.append("TN Scholarship Portal / scholarships.gov.in before applying.");

        resultArea.setText(sb.toString());
    }

    void clearForm() {
        nameField.setText("");
        ageField.setText("");
        genderChoice.select(0);
        communityChoice.select(0);
        educationChoice.select(0);
        loanChoice.select(0);
        resultArea.setText("");
    }

