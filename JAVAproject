    // ---------- Scholarship data model ----------
    static class Scholarship {
        String name;
        String[] allowedGenders;
        String[] allowedCommunities;
        String[] allowedEducation;
        int minAge, maxAge;
        String amount;
        String type; // "Scholarship" or "Loan"

        Scholarship(String name, String[] genders, String[] communities,
                    String[] education, int minAge, int maxAge, String amount) {
            this(name, genders, communities, education, minAge, maxAge, amount, "Scholarship");
        }

        Scholarship(String name, String[] genders, String[] communities,
                    String[] education, int minAge, int maxAge, String amount, String type) {
            this.name = name;
            this.allowedGenders = genders;
            this.allowedCommunities = communities;
            this.allowedEducation = education;
            this.minAge = minAge;
            this.maxAge = maxAge;
            this.amount = amount;
            this.type = type;
        }

        boolean matches(int age, String gender, String community, String education) {
            if (age < minAge || age > maxAge) return false;
            if (!contains(allowedGenders, gender)) return false;
            if (!contains(allowedCommunities, community)) return false;
            if (!contains(allowedEducation, education)) return false;
            return true;
        }

        private boolean contains(String[] arr, String value) {
            for (String s : arr) {
                if (s.equalsIgnoreCase("Any") || s.equalsIgnoreCase(value)) return true;
            }
            return false;
        }
    }

